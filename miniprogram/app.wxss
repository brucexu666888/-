page {
  --primary: #1f4e8c;
  background: #f4f6fa;
  color: #1d2433;
  font-size: 28rpx;
  line-height: 1.5;
}

.container { padding: 24rpx; }

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 84rpx; border-radius: 16rpx; font-size: 30rpx;
  background: #fff; color: #1d2433; border: 1rpx solid #e1e5ee;
  margin: 0; padding: 0 32rpx; line-height: 84rpx;
}
.btn::after { border: none; }
.btn.primary { background: #1f4e8c; color: #fff; border-color: #1f4e8c; }
.btn.danger { color: #c0392b; }
.btn.small { height: 60rpx; line-height: 60rpx; font-size: 26rpx; padding: 0 24rpx; }
.btn[disabled] { opacity: .6; }

.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; }
.muted { color: #6b7385; font-size: 24rpx; }
.empty { text-align: center; color: #6b7385; padding: 120rpx 40rpx; }

.badge { display: inline-block; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 999rpx; margin-left: 10rpx; font-weight: 600; vertical-align: 4rpx; }
.badge.new { background: #fde8e6; color: #c0392b; }
.badge.updated { background: #fff1de; color: #d9822b; }

.icon { flex: none; width: 88rpx; height: 88rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 700; color: #fff; }
.cat-product { background: #1f6fd1; }
.cat-price { background: #d9822b; }
.cat-training { background: #1e8e5a; }
.cat-sample { background: #8e44ad; }
.cat-manual { background: #2c7a7b; }
.cat-marketing { background: #c0392b; }

.input {
  background: #fff; border: 1rpx solid #e1e5ee; border-radius: 16rpx;
  height: 88rpx; padding: 0 24rpx; font-size: 30rpx;
}
.label { font-size: 24rpx; color: #6b7385; margin: 24rpx 0 10rpx; }
